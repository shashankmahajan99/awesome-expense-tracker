---
import BaseHead from "../components/BaseHead.astro";
import AppSidebar from "../components/AppSidebar.astro";
import AppTopbar from "../components/AppTopbar.astro";
import DateWindow from "../components/DateWindow.astro";
import QuickReview from "../components/QuickReview.astro";
---
<!doctype html>
<html lang="en">
  <head><BaseHead title="Transactions — Paisa Inbox" description="Search, edit, categorise, and manage all your transactions." /></head>
  <body>
    <div class="app-shell">
      <AppSidebar active="transactions" />
      <main>
        <AppTopbar title="Transactions" subtitle="SEARCH, FIX, AND ORGANISE" action="add" />
        <section class="workspace-page">
          <div class="page-intro"><div><span class="eyebrow">YOUR COMPLETE LEDGER</span><h2>Every payment, under your control.</h2><p>Search, edit, categorise, review, or remove a transaction. Changes update your dashboard and insights immediately.</p></div><div class="page-intro-actions"><button class="secondary-button" id="manage-payment-accounts" type="button">Payment methods</button><button class="secondary-button" id="manage-loans" type="button">Loans & EMIs</button></div></div>
          <section class="panel ledger-panel">
            <div class="ledger-toolbar">
              <label class="search-field"><span aria-hidden="true">⌕</span><input id="transaction-search" type="search" placeholder="Search merchant, note, or context" /></label>
              <label class="filter-field"><span>Review state</span><select id="status-filter"><option value="all">Any review state</option><option value="unresolved">Needs review</option><option value="explained">Explained</option><option value="known">Known / repeat</option><option value="deferred">Deferred by me</option></select></label>
              <label class="filter-field"><span>Category</span><select id="category-filter"><option value="all">Any category</option></select></label>
              <DateWindow id="transactions-date-window" label="Period" />
            </div>
            <div class="ledger-summary"><strong id="ledger-count"><span class="skeleton-line medium"></span></strong><span id="ledger-total"><span class="skeleton-line short"></span></span></div>
            <div class="bulk-toolbar" id="bulk-toolbar" hidden><strong><span id="selected-count">0</span> selected</strong><button class="danger-button" id="delete-selected" type="button">Delete selected</button><button class="secondary-button" id="clear-selection" type="button">Cancel</button></div>
            <div class="ledger-table" role="table" aria-label="Transactions">
              <div class="ledger-row ledger-head" role="row"><span class="ledger-select"><input id="select-page" type="checkbox" aria-label="Select all transactions on this page" /> Payment</span><span>Category</span><span>Status</span><span>Amount</span><span>Actions</span></div>
              <div id="ledger-rows" class="ledger-rows" aria-busy="true">{[1,2,3,4,5].map(() => <div class="ledger-row ledger-skeleton" aria-hidden="true"><span class="ledger-merchant"><i class="skeleton-avatar"></i><span><b class="skeleton-line medium"></b><b class="skeleton-line short"></b></span></span><span class="skeleton-line medium"></span><span class="skeleton-line short"></span><span class="skeleton-line short"></span><span class="skeleton-line medium"></span></div>)}</div>
            </div>
            <div class="ledger-empty" id="ledger-empty" hidden><span>⌕</span><h3>No transactions found.</h3><p>Try another filter or add a transaction manually.</p><button class="primary-button" type="button" data-add-transaction>Add transaction</button></div>
            <nav class="ledger-pagination" id="ledger-pagination" aria-label="Transaction pages" hidden>
              <button class="secondary-button" id="ledger-previous" type="button">← Previous</button>
              <span><strong id="ledger-page">Page 1 of 1</strong><small id="ledger-range">Showing 0 transactions</small></span>
              <button class="secondary-button" id="ledger-next" type="button">Next →</button>
            </nav>
          </section>
        </section>
        <footer><span>Paisa Inbox gives you a clean ledger without turning money into admin.</span><span><a href="/privacy">Privacy</a> · <a href="/terms">Terms</a></span></footer>
      </main>
    </div>

    <dialog class="sheet-dialog transaction-editor" id="transaction-dialog">
      <div class="sheet-top"><div><span class="eyebrow" id="editor-eyebrow">NEW TRANSACTION</span><h2 id="editor-title">Add a payment.</h2></div><button type="button" data-close-dialog aria-label="Close transaction editor">×</button></div>
      <form id="transaction-form">
        <input type="hidden" name="id" />
        <div class="editor-grid">
          <label><span>Merchant</span><input name="merchant" required maxlength="160" placeholder="e.g. Swiggy" /></label>
          <label><span>Amount (₹)</span><input name="amount" required type="number" min="0.01" step="0.01" placeholder="0.00" /></label>
          <label><span>Payment account</span><div class="account-control"><select name="accountTag" id="transaction-account"><option value="">No payment account</option></select><button type="button" id="new-payment-account">＋ New</button></div></label>
          <label><span>Category <small>(optional)</small></span><div class="category-control"><div class="category-input"><input id="transaction-category" name="category" autocomplete="off" placeholder="Choose or type a category" /><button id="show-categories" type="button" aria-label="Show category suggestions" aria-expanded="false">⌄</button></div><div class="category-suggestions" id="category-suggestions" role="listbox" hidden></div></div></label>
          <section class="loan-allocation wide" id="loan-allocation" hidden><div><span class="eyebrow">LOAN OR EMI PAYMENT</span><strong>Which loan did this payment reduce?</strong><small>Linking the EMI keeps outstanding balance and repayment insights accurate.</small></div><div class="editor-grid"><label><span>Loan / EMI</span><div class="account-control"><select name="loanId" id="transaction-loan"><option value="">Choose a loan</option></select><button type="button" id="new-loan">＋ New</button></div></label><label><span>EMI number <small>(optional)</small></span><input name="emiNumber" type="number" min="1" step="1" placeholder="e.g. 6" /></label><label><span>Principal component (₹)</span><input name="principalComponent" type="number" min="0" step="0.01" /></label><label><span>Interest component (₹)</span><input name="interestComponent" type="number" min="0" step="0.01" /></label></div></section>
          <details class="advanced-transaction-fields wide" id="transaction-advanced"><summary><span>Date, status & optional details</span><small>Today · Needs review</small></summary><div class="editor-grid">
            <label><span>Date</span><input name="occurredDate" required type="date" /></label>
            <label><span>Time <small>(optional)</small></span><input name="occurredTime" type="time" /></label>
            <label><span>Review status</span><select name="reviewStatus"><option value="unresolved">Needs review</option><option value="explained">Explained</option><option value="known">Known / repeat</option><option value="deferred">Deferred</option></select></label>
            <label class="wide"><span>Description</span><input name="description" maxlength="300" placeholder="Optional bank narration" /></label>
            <label class="wide"><span>Context or note</span><textarea name="context" rows="3" maxlength="1000" placeholder="What was this payment for?"></textarea></label>
          </div></details>
        </div>
        <p class="form-error" id="form-error" hidden></p>
        <div class="sheet-actions editor-actions"><button class="danger-button" id="delete-transaction" type="button" hidden>Delete transaction</button><span></span><button class="secondary-button" type="button" data-close-dialog>Cancel</button><button class="primary-button" type="submit" id="save-transaction">Save transaction</button></div>
      </form>
    </dialog>
    <dialog class="sheet-dialog account-dialog entity-manager" id="account-dialog"><div class="sheet-top"><div><span class="eyebrow">PAYMENT METHODS</span><h2>Manage banks, cards, wallets and apps.</h2></div><button type="button" data-close-account aria-label="Close">×</button></div><div class="entity-list" id="payment-account-list"></div><form id="account-form"><input type="hidden" name="id" /><div class="editor-grid"><label><span>Name</span><input name="name" required maxlength="100" placeholder="ICICI Salary Account" /></label><label><span>Type</span><select name="kind"><option value="bank">Bank account</option><option value="card">Credit / debit card</option><option value="wallet">Wallet</option><option value="app">Payment app</option><option value="cash">Cash</option><option value="other">Other</option></select></label><label><span>Institution</span><input name="institution" maxlength="80" placeholder="ICICI" /></label><label><span>Last four <small>(optional)</small></span><input name="lastFour" inputmode="numeric" maxlength="4" placeholder="1234" /></label></div><p class="sheet-intro">Edit names and details here. A method linked to transactions cannot be deleted until those transactions are moved.</p><div class="sheet-actions"><button class="secondary-button" type="button" id="reset-payment-account">New method</button><button class="primary-button" type="submit">Save payment method</button></div></form></dialog>
    <dialog class="sheet-dialog loan-dialog entity-manager" id="loan-dialog"><div class="sheet-top"><div><span class="eyebrow">LOANS & EMI PLANS</span><h2>Track what every EMI is paying down.</h2></div><button type="button" data-close-loan aria-label="Close">×</button></div><div class="entity-list" id="loan-list"></div><form id="loan-form"><input type="hidden" name="id" /><label class="loan-file-drop"><input id="loan-pdf" type="file" accept=".pdf,application/pdf" /><span>Import a loan sanction letter or repayment schedule PDF</span><small>Parsed locally; review every field before saving.</small></label><div class="editor-grid"><label><span>Loan name</span><input name="name" required maxlength="120" placeholder="ICICI Home Loan" /></label><label><span>Lender</span><input name="lender" maxlength="100" placeholder="ICICI Bank" /></label><label><span>Loan type</span><select name="loanType"><option value="personal">Personal loan</option><option value="home">Home loan</option><option value="vehicle">Vehicle loan</option><option value="education">Education loan</option><option value="consumer">Consumer EMI</option><option value="credit_card">Credit-card EMI</option><option value="other">Other</option></select></label><label><span>Loan account / last digits</span><input name="accountNumber" maxlength="40" /></label><label><span>Original principal (₹)</span><input name="principal" type="number" min="0" step="0.01" /></label><label><span>Outstanding principal (₹)</span><input name="outstanding" type="number" min="0" step="0.01" /></label><label><span>EMI amount (₹)</span><input name="emiAmount" type="number" min="0" step="0.01" /></label><label><span>Tenure (months)</span><input name="tenureMonths" type="number" min="0" max="1200" /></label><label><span>Interest rate (% p.a.)</span><input name="interestRate" type="number" min="0" max="1000" step="0.01" /></label><label><span>Total interest (₹)</span><input name="totalInterest" type="number" min="0" step="0.01" /></label><label><span>Processing fee (₹)</span><input name="processingFee" type="number" min="0" step="0.01" /></label><label><span>Status</span><select name="status"><option value="active">Active</option><option value="closed">Closed</option><option value="paused">Paused</option></select></label><label><span>Start date</span><input name="startDate" type="date" /></label><label><span>Next due date</span><input name="nextDueDate" type="date" /></label><label class="toggle-row wide"><span><strong>No-cost EMI</strong><small>Interest is zero; processing fee or merchant discount can still be recorded.</small></span><input name="noCostEmi" type="checkbox" /><i></i></label></div><p class="form-error" id="loan-form-error" hidden></p><div class="sheet-actions"><button class="secondary-button" type="button" id="reset-loan">New loan</button><button class="primary-button" type="submit">Save loan</button></div></form></dialog>
    <QuickReview />
    <div class="toast" role="status" aria-live="polite"><span>✓</span><p><strong>Saved</strong><small>Your ledger is up to date</small></p></div>
    <script is:inline src="/date-window.js?v=5"></script><script is:inline type="module" src="/transactions.js?v=21"></script>
  </body>
</html>

---
import BaseHead from "../components/BaseHead.astro";
import AppSidebar from "../components/AppSidebar.astro";
import AppTopbar from "../components/AppTopbar.astro";
import DateWindow from "../components/DateWindow.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Paisa Inbox — Your daily financial inbox" description="Understand what changed financially today, in two minutes." />
  </head>
  <body>
    <div class="app-shell">
      <AppSidebar active="overview" />

      <main id="top">
        <AppTopbar title="Good evening." subtitle="YOUR DAILY FINANCIAL INBOX" action="review" />
        <section class="hero" id="overview">
          <div class="dashboard-filter"><span><small>VIEWING</small><strong>Financial activity</strong></span><DateWindow id="dashboard-date-window" /></div>
          <div class="hero-copy">
            <div class="status-pill"><i></i> YOUR DAILY FINANCIAL INBOX</div>
            <h2 id="hero-title"><span class="skeleton-line hero-heading"></span><span class="skeleton-line hero-heading medium"></span></h2>
            <p id="hero-summary"><span class="skeleton-line wide"></span><span class="skeleton-line medium"></span></p>
            <div class="hero-actions"><button class="review-button loading-control" type="button" data-open-review disabled><strong data-review-label><span class="skeleton-line button-line"></span></strong></button><span><strong id="review-estimate"><span class="skeleton-line short"></span></strong><small>Estimated review time</small></span></div>
          </div>
          <div class="hero-visual" aria-label="Spending breakdown">
            <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
            <div class="sun"><span id="visual-total"><i class="skeleton-disc"></i></span><small>TOTAL TRACKED</small></div>
            <div class="bubble routine"><strong id="visual-understood"><i class="skeleton-disc small"></i></strong><small>UNDERSTOOD</small></div>
            <div class="bubble travel"><strong id="visual-largest"><i class="skeleton-disc small"></i></strong><small>LARGEST</small></div>
            <div class="bubble unknown"><strong id="visual-unresolved"><i class="skeleton-disc small"></i></strong><small>UNEXPLAINED</small></div>
          </div>
        </section>

        <section class="metrics" aria-label="Financial summary">
          <article><div><span class="metric-icon sage">↗</span><span class="eyebrow">TOTAL TRACKED</span></div><strong id="tracked-total"><span class="skeleton-line metric-line"></span></strong><p id="tracked-count"><span class="skeleton-line medium"></span></p></article>
          <article><div><span class="metric-icon coral">◎</span><span class="eyebrow">UNDERSTOOD</span></div><strong id="understood-percent"><span class="skeleton-line metric-line"></span></strong><p id="understood-detail"><span class="skeleton-line medium"></span></p></article>
          <article><div><span class="metric-icon blue">◇</span><span class="eyebrow">LARGEST PAYMENT</span></div><strong id="largest-payment"><span class="skeleton-line metric-line"></span></strong><p id="largest-detail"><span class="skeleton-line medium"></span></p></article>
          <article><div><span class="metric-icon gold">◷</span><span class="eyebrow">NEXT REVIEW</span></div><strong id="next-review-time"><span class="skeleton-line metric-line"></span></strong><p><span id="reminder-mode"><span class="skeleton-line short"></span></span><span id="reminder-suffix"></span></p></article>
        </section>

        <section class="content-grid" id="inbox">
          <article class="panel inbox-panel">
            <div class="panel-heading"><div><span class="eyebrow">NEEDS YOUR INPUT</span><h3>Daily inbox</h3></div><div class="panel-actions"><button type="button" data-open-batch disabled>Explain together</button><button type="button" data-open-review disabled>Review all <span>→</span></button></div></div>
            <div class="transaction-list" id="transaction-list" aria-busy="true">{[1,2,3,4].map(() => <div class="transaction skeleton-row" aria-hidden="true"><span class="skeleton-avatar"></span><span><i class="skeleton-line medium"></i><i class="skeleton-line short"></i></span><span><i class="skeleton-line medium"></i><i class="skeleton-line short"></i></span><i class="skeleton-line amount-line"></i></div>)}</div>
            <div class="empty-inbox" hidden><span>✓</span><h4>All clear for today.</h4><p>You’ve explained everything that matters.</p></div>
          </article>

          <div class="dashboard-side" id="dashboard-side"><article class="panel snapshot" id="insights">
            <div class="panel-heading"><div><span class="eyebrow">RECENT ACTIVITY</span><h3>Spending snapshot</h3></div><a href="/insights">Full insights →</a></div>
            <div class="month-total"><strong id="snapshot-total"><span class="skeleton-line metric-line"></span></strong><span id="snapshot-caption"><span class="skeleton-line short"></span></span></div>
            <div class="bars skeleton-bars" id="snapshot-bars" aria-label="Recent spending" aria-busy="true">{[30,52,42,69,55,82,64].map((height) => <div><i style={`height:${height}%`}></i><small class="skeleton-line tiny"></small></div>)}</div>
            <div class="insight-note" id="snapshot-note"><span>✦</span><p><span class="skeleton-line wide"></span><span class="skeleton-line medium"></span></p></div>
          </article>
          <article class="panel categories dashboard-secondary" id="dashboard-categories-card"><div class="panel-heading"><div><span class="eyebrow">WHERE IT WENT</span><h3>Top categories</h3></div><a href="/insights">View details →</a></div><div class="category-list" id="dashboard-categories" aria-busy="true">{[1,2,3,4].map(() => <div class="category skeleton-category"><div><span class="skeleton-dot"></span><i class="skeleton-line medium"></i><i class="skeleton-line short"></i></div><div class="track"><i></i></div></div>)}</div></article>
          <article class="panel focus-card dashboard-secondary" id="dashboard-focus-card"><span class="eyebrow">ONE THING TO KNOW</span><div class="focus-icon">↗</div><h3 id="focus-title"><span class="skeleton-line wide dark"></span><span class="skeleton-line medium dark"></span></h3><p id="focus-detail"><span class="skeleton-line wide dark"></span><span class="skeleton-line medium dark"></span></p><a href="/insights">Explore insights →</a></article></div>
        </section>

        <section class="dashboard-bottom" id="activity"></section>
        <footer><span>Paisa Inbox understands your spending, without making you log every little thing.</span><span><a href="/privacy">Privacy</a> · <a href="/terms">Terms</a> · Last synced just now</span></footer>
      </main>
    </div>

    <dialog class="review-dialog" id="review-dialog">
      <div class="review-shell">
        <div class="review-top"><button class="back-button" type="button" data-close-review>← Dashboard</button><div><span class="eyebrow">DAILY REVIEW</span><strong><span id="review-position">1</span> of <span id="review-total">5</span></strong></div><span class="review-nav"><button type="button" id="review-previous" aria-label="Previous payment">←</button><button type="button" id="review-next" aria-label="Next payment">→</button><button type="button" data-close-review aria-label="Close review">×</button></span></div>
        <div class="progress"><i id="review-progress"></i></div>
        <div class="review-card">
          <span class="merchant-icon amber large" id="review-icon">A</span><p id="review-meta">TODAY · 5:42 PM</p><h2 id="review-amount">₹8,400</h2><h3 id="review-merchant">Amazon</h3>
          <div class="review-category-block"><span>Choose a category</span><label class="review-category"><span class="sr-only">Category</span><select id="review-category"></select><input id="review-category-custom" type="text" placeholder="Type a new category" hidden /></label><div class="category-chips" id="review-category-chips" aria-label="Quick categories"></div></div>
          <section class="loan-allocation" id="review-loan-allocation" hidden><strong>Which loan did this payment reduce?</strong><label><span>Loan / EMI plan</span><select id="review-loan"></select></label><div class="review-edit-grid"><label><span>EMI number</span><input id="review-emi-number" type="number" min="1" /></label><label><span>Principal component (₹)</span><input id="review-principal-component" type="number" min="0" step="0.01" /></label><label><span>Interest component (₹)</span><input id="review-interest-component" type="number" min="0" step="0.01" /></label></div><a href="/transactions?newLoan=1">Create a loan or import its PDF →</a></section>
          <details class="review-details"><summary>Edit payment details</summary><div class="review-edit-grid">
            <label><span>Merchant</span><input id="review-edit-merchant" maxlength="160" /></label><label><span>Amount (₹)</span><input id="review-edit-amount" type="number" min="0.01" step="0.01" /></label>
            <label><span>Date</span><input id="review-edit-date" type="date" /></label><label><span>Exact time <small>(optional)</small></span><input id="review-edit-time" type="time" /></label>
            <label><span>Payment account</span><select id="review-edit-account"><option value="">No payment account</option></select></label>
          </div></details>
          <div class="prompt"><span>✦</span><p><strong id="review-question">Add any context that will help later.</strong><small id="review-hint">A category is enough; a short note makes insights clearer.</small></p></div>
          <button class="voice-button" id="voice-button" type="button"><span>●</span><strong data-voice-label>Tap to speak</strong><small data-voice-hint>or type your answer below</small></button>
          <label class="answer-field"><span class="sr-only">Explain this payment</span><input id="answer-input" type="text" placeholder="e.g. New office chair, work expense" /><i class="field-loader" aria-label="Listening" hidden></i><button type="button" id="submit-answer" aria-label="Save and review next payment"><span>✓</span></button></label>
          <div class="quick-actions"><button type="button" data-action="known">Save category & mark known</button><button type="button" data-action="group">Explain together</button><button type="button" data-action="defer">Review later</button></div>
        </div>
        <p class="keyboard-hint">Press <kbd>Enter</kbd> to save · <kbd>S</kbd> to skip · <kbd>Esc</kbd> to close</p>
      </div>
    </dialog>

    <dialog class="sheet-dialog batch-dialog" id="batch-dialog">
      <div class="sheet-top"><div><span class="eyebrow">BATCH EXPLANATION</span><h2>Explain several payments at once.</h2></div><button type="button" data-close-batch aria-label="Close batch explanation">×</button></div>
      <p class="sheet-intro">Describe them naturally using merchant clues, categories, or amounts. Paisa Inbox will group and categorise matches while leaving uncertain payments untouched.</p>
      <div class="batch-example"><span>✦</span><p>“The petrol and toll were travel. ₹450 and ₹720 were groceries.”</p></div>
      <label class="batch-field listening-field"><span>What happened?</span><textarea id="batch-input" rows="5" placeholder="Speak or type one sentence about today’s spending…"></textarea><i class="field-loader" aria-label="Listening" hidden></i></label>
      <label class="batch-category"><span>Apply category <small>(optional)</small></span><select id="batch-category"><option value="">Infer from what I wrote</option></select></label>
      <div class="batch-list" id="batch-list" aria-label="Payments available to match"></div>
      <div class="sheet-actions"><button class="secondary-button" type="button" id="batch-voice" data-voice-label>● Speak instead</button><button class="primary-button" type="button" id="batch-submit"><span>Match & explain →</span></button></div>
      <div class="batch-result" id="batch-result" hidden><span>✓</span><p><strong>Explanation applied</strong><small id="batch-result-text"></small></p></div>
    </dialog>

    <dialog class="sheet-dialog preferences-dialog" id="preferences-dialog">
      <div class="sheet-top"><div><span class="eyebrow">REMINDER PREFERENCES</span><h2>Make reminders feel right.</h2></div><button type="button" data-close-preferences aria-label="Close preferences">×</button></div>
      <p class="sheet-intro">Paisa Inbox sends at most one useful reminder a day, and stays quiet when everything is already understood.</p>
      <form id="preferences-form">
        <fieldset class="personality-options"><legend>Reminder personality</legend>
          <label><input type="radio" name="personality" value="Gentle" /><span><strong>Gentle</strong><small>Only when unresolved spending exceeds ₹2,000.</small></span></label>
          <label><input type="radio" name="personality" value="Balanced" checked /><span><strong>Balanced <em>Recommended</em></strong><small>Two payments or one important payment remains.</small></span></label>
          <label><input type="radio" name="personality" value="Strict" /><span><strong>Strict</strong><small>Daily whenever anything meaningful remains.</small></span></label>
        </fieldset>
        <div class="preference-grid">
          <label><span>Preferred review time</span><input name="reviewTime" type="time" value="21:30" /></label>
          <label><span>Important payment</span><select name="importantAmount"><option value="1000">Above ₹1,000</option><option value="2000">Above ₹2,000</option><option value="5000">Above ₹5,000</option></select></label>
          <label><span>Quiet hours start</span><input name="quietStart" type="time" value="23:00" /></label>
          <label><span>Quiet hours end</span><input name="quietEnd" type="time" value="07:00" /></label>
        </div>
        <label class="toggle-row"><span><strong>Sunday cleanup</strong><small>Show a weekly catch-up only when missing context affects your insights.</small></span><input name="weeklyCleanup" type="checkbox" checked /><i></i></label>
        <div class="preference-note"><span>♢</span><p><strong>Anti-annoyance rules are always on.</strong><small>No repeated evening alerts, known EMIs, reversals, refunds, or reminders after you’ve already reviewed.</small></p></div>
        <div class="data-controls"><div><strong>Your data</strong><small>Download a copy, delete every synced transaction for a fresh import, or delete the account.</small></div><span><button type="button" id="export-data">Export</button><button type="button" id="reset-financial-data">Delete all transactions</button><button type="button" id="delete-account">Delete account</button></span></div>
        <div class="sheet-actions"><button class="secondary-button" type="button" data-close-preferences>Cancel</button><button class="primary-button" type="submit">Save preferences</button></div>
      </form>
    </dialog>

    <dialog class="completion-dialog reset-dialog" id="reset-dialog">
      <div class="completion-mark">!</div><span class="eyebrow">DELETE EVERYWHERE</span><h2>Delete every transaction?</h2>
      <p>This permanently removes transactions and review history from the web dashboard and every connected iPhone. Your sign-in and reminder preferences stay intact.</p>
      <div class="sheet-actions"><button class="secondary-button" type="button" id="cancel-reset">Keep my data</button><button class="danger-button" type="button" id="confirm-reset">Delete all transactions</button></div>
    </dialog>

    <dialog class="completion-dialog" id="completion-dialog">
      <div class="completion-mark">✓</div><span class="eyebrow">REVIEW COMPLETE</span><h2>Done. Your money makes sense.</h2>
      <p>Today was higher than usual mainly because of the Gurgaon trip. Your normal day-to-day spending was unchanged.</p>
      <div class="completion-stats"><span><strong id="completed-count">5</strong><small>PAYMENTS REVIEWED</small></span><span><strong>~90 sec</strong><small>TIME SPENT</small></span><span><strong>12 days</strong><small>CLARITY STREAK</small></span></div>
      <button class="primary-button" type="button" data-close-completion>Back to overview</button>
    </dialog>

    <dialog class="sheet-dialog import-dialog" id="import-dialog">
      <div class="sheet-top"><div><span class="eyebrow">IMPORT TRANSACTIONS</span><h2>Bring your spending into Paisa Inbox.</h2></div><button type="button" data-close-import aria-label="Close import">×</button></div>
      <p class="sheet-intro">Select bank, card, and Paytm statements together. Paisa Inbox verifies matching entries across sources instead of counting the same payment twice.</p>
      <label class="file-drop" id="file-drop"><input id="statement-file" type="file" accept=".csv,.pdf,text/csv,application/pdf" multiple /><span>⇧</span><strong>Choose PDFs or CSVs</strong><small>Multiple files supported · up to 20 MB each · parsed locally</small></label>
      <div class="import-loading" id="import-loading" hidden><i></i><span><strong id="import-progress-title">Preparing statements…</strong><small id="import-progress-detail">Reading file metadata</small><b><em id="import-progress-bar"></em></b></span></div>
      <div class="import-files" id="import-files" hidden aria-live="polite"></div>
      <div class="import-preview" id="import-preview" hidden><div><strong id="import-count">0 transactions ready</strong><small id="import-filename"></small></div><button type="button" id="clear-import">Remove all</button></div>
      <div class="preference-note"><span>♢</span><p><strong>Your raw statement is never uploaded or stored.</strong><small>Extraction happens locally. Only the parsed transaction rows are sent after you confirm.</small></p></div>
      <div class="sheet-actions"><button class="secondary-button" type="button" data-close-import>Cancel</button><button class="primary-button" type="button" id="import-submit" disabled>Import securely</button></div>
    </dialog>

    <div class="toast" role="status" aria-live="polite"><span>✓</span><p><strong>Context saved</strong><small>Moving to the next payment</small></p></div>

    <script is:inline src="/date-window.js?v=5"></script><script is:inline src="/client.js?v=21"></script>
  </body>
</html>

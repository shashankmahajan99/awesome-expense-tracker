---
import BaseHead from "../components/BaseHead.astro";
import AppSidebar from "../components/AppSidebar.astro";
import AppTopbar from "../components/AppTopbar.astro";

const categories = [
  { name: "Food & dining", amount: "₹8,240", percent: 72, color: "#e6825b" },
  { name: "Travel", amount: "₹6,180", percent: 54, color: "#5f8f87" },
  { name: "Shopping", amount: "₹4,760", percent: 41, color: "#dbad4d" },
  { name: "Bills", amount: "₹3,420", percent: 29, color: "#7685a8" },
];

const transactions = [
  { id: 1, merchant: "Amazon", meta: "Today · 5:42 PM", amount: "₹8,400", icon: "A", tone: "amber", status: "Needs context", detail: "Unusually large for this merchant" },
  { id: 2, merchant: "Zomato", meta: "Today · 1:18 PM", amount: "₹740", icon: "Z", tone: "red", status: "Needs context", detail: "Dining · possibly shared" },
  { id: 3, merchant: "Indian Oil", meta: "Today · 9:06 AM", amount: "₹2,100", icon: "IO", tone: "blue", status: "Likely travel", detail: "Fuel · confidence 82%" },
  { id: 4, merchant: "Delhi Gurgaon Toll", meta: "Today · 8:44 AM", amount: "₹120", icon: "T", tone: "green", status: "Likely travel", detail: "Matches your Gurgaon route" },
  { id: 5, merchant: "Blinkit", meta: "Yesterday · 8:12 PM", amount: "₹960", icon: "B", tone: "yellow", status: "Needs context", detail: "Likely groceries" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title="Paisa — Your daily financial inbox" description="Understand what changed financially today, in two minutes." />
  </head>
  <body>
    <div class="app-shell">
      <AppSidebar active="overview" />

      <main id="top">
        <AppTopbar title="Good evening." subtitle="YOUR DAILY FINANCIAL INBOX" action="review" />

        <section class="hero" id="overview">
          <div class="hero-copy">
            <div class="status-pill"><i></i> YOUR DAILY FINANCIAL INBOX</div>
            <h2>A few things need<br />your attention.</h2>
            <p id="hero-summary">Loading your latest transactions and unresolved payments…</p>
            <div class="hero-actions"><button class="review-button" type="button" data-open-review><strong data-review-label>Review payments</strong> <span>→</span></button><span><strong id="review-estimate">~1 min</strong><small>Estimated review time</small></span></div>
          </div>
          <div class="hero-visual" aria-label="Spending breakdown">
            <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
            <div class="sun"><span>₹6,420</span><small>SPENT TODAY</small></div>
            <div class="bubble routine"><strong>₹2,800</strong><small>ROUTINE</small></div>
            <div class="bubble travel"><strong>₹2,100</strong><small>TRAVEL</small></div>
            <div class="bubble unknown"><strong>₹1,520</strong><small>UNEXPLAINED</small></div>
          </div>
        </section>

        <section class="metrics" aria-label="Financial summary">
          <article><div><span class="metric-icon sage">↗</span><span class="eyebrow">TOTAL TRACKED</span></div><strong id="tracked-total">—</strong><p id="tracked-count">Loading payments…</p></article>
          <article><div><span class="metric-icon coral">◎</span><span class="eyebrow">UNDERSTOOD</span></div><strong id="understood-percent">—</strong><p id="understood-detail">Review completeness</p></article>
          <article><div><span class="metric-icon blue">◇</span><span class="eyebrow">MONEY TO COLLECT</span></div><strong>₹2,350</strong><p>Rahul and 2 others owe you</p></article>
          <article><div><span class="metric-icon gold">◷</span><span class="eyebrow">NEXT REVIEW</span></div><strong id="next-review-time">9:30 PM</strong><p><span id="reminder-mode">Balanced</span> reminder · today</p></article>
        </section>

        <section class="content-grid" id="inbox">
          <article class="panel inbox-panel">
            <div class="panel-heading"><div><span class="eyebrow">NEEDS YOUR INPUT</span><h3>Daily inbox</h3></div><div class="panel-actions"><button type="button" data-open-batch>Explain together</button><button type="button" data-open-review>Review all <span>→</span></button></div></div>
            <div class="transaction-list" id="transaction-list">
              {transactions.map((transaction) => (
                <button class="transaction" type="button" data-id={transaction.id}>
                  <span class={`merchant-icon ${transaction.tone}`}>{transaction.icon}</span>
                  <span class="merchant-info"><strong>{transaction.merchant}</strong><small>{transaction.meta}</small></span>
                  <span class="transaction-context"><span>{transaction.status}</span><small>{transaction.detail}</small></span>
                  <strong class="amount">{transaction.amount}</strong><span class="chevron">›</span>
                </button>
              ))}
            </div>
            <div class="empty-inbox" hidden><span>✓</span><h4>All clear for today.</h4><p>You’ve explained everything that matters.</p></div>
          </article>

          <article class="panel snapshot" id="insights">
            <div class="panel-heading"><div><span class="eyebrow">AUGUST SO FAR</span><h3>Spending snapshot</h3></div><a href="/insights">Full insights →</a></div>
            <div class="month-total"><strong>₹42,680</strong><span><i>↓ 8%</i> vs July</span></div>
            <div class="bars" aria-label="Spending over the last seven days">{[34,51,42,68,55,86,64].map((height,index) => <div><i style={`height:${height}%`} class={index === 5 ? "peak" : ""}></i><small>{["M","T","W","T","F","S","S"][index]}</small></div>)}</div>
            <div class="insight-note"><span>✦</span><p><strong>You're spending less.</strong><br />Dining is down ₹1,820 from this time last month.</p></div>
          </article>
        </section>

        <section class="lower-grid" id="activity">
          <article class="panel categories"><div class="panel-heading"><div><span class="eyebrow">WHERE IT WENT</span><h3>Top categories</h3></div><a href="/insights">View details →</a></div><div class="category-list">{categories.map((category) => <div class="category"><div><span class="dot" style={`background:${category.color}`}></span><strong>{category.name}</strong><b>{category.amount}</b></div><div class="track"><i style={`width:${category.percent}%;background:${category.color}`}></i></div></div>)}</div></article>
          <article class="panel focus-card"><span class="eyebrow">ONE THING TO KNOW</span><div class="focus-icon">↗</div><h3>Your Gurgaon trip cost ₹3,180.</h3><p>Fuel, tolls, and food made it your largest out-of-routine expense this week.</p><button type="button" data-open-review>Review trip expenses →</button></article>
        </section>
        <footer><span>Paisa understands your spending, without making you log every little thing.</span><span><a href="/privacy">Privacy</a> · <a href="/terms">Terms</a> · Last synced just now</span></footer>
      </main>
    </div>

    <dialog class="review-dialog" id="review-dialog">
      <div class="review-shell">
        <div class="review-top"><button class="back-button" type="button" data-close-review>← Dashboard</button><div><span class="eyebrow">DAILY REVIEW</span><strong><span id="review-position">1</span> of <span id="review-total">5</span></strong></div><button type="button" data-close-review aria-label="Close review">×</button></div>
        <div class="progress"><i id="review-progress"></i></div>
        <div class="review-card">
          <span class="merchant-icon amber large" id="review-icon">A</span><p id="review-meta">TODAY · 5:42 PM</p><h2 id="review-amount">₹8,400</h2><h3 id="review-merchant">Amazon</h3>
          <div class="prompt"><span>✦</span><p><strong id="review-question">What was this payment for?</strong><small id="review-hint">It’s larger than your usual Amazon purchase.</small></p></div>
          <button class="voice-button" id="voice-button" type="button"><span>●</span><strong data-voice-label>Tap to speak</strong><small data-voice-hint>or type your answer below</small></button>
          <label class="answer-field"><span class="sr-only">Explain this payment</span><input id="answer-input" type="text" placeholder="e.g. New office chair, work expense" /><i class="field-loader" aria-label="Listening" hidden></i><button type="button" id="submit-answer" aria-label="Save and return to dashboard">✓</button></label>
          <div class="quick-actions"><button type="button" data-action="known">Known / repeat</button><button type="button" data-action="group">Group with another</button><button type="button" data-action="skip">Skip for now</button></div>
        </div>
        <p class="keyboard-hint">Press <kbd>Enter</kbd> to save · <kbd>S</kbd> to skip · <kbd>Esc</kbd> to close</p>
      </div>
    </dialog>

    <dialog class="sheet-dialog batch-dialog" id="batch-dialog">
      <div class="sheet-top"><div><span class="eyebrow">BATCH EXPLANATION</span><h2>Explain several payments at once.</h2></div><button type="button" data-close-batch aria-label="Close batch explanation">×</button></div>
      <p class="sheet-intro">Mention merchants naturally. Paisa will locate the matching payments, group related spending, and leave only unmatched items for later.</p>
      <div class="batch-example"><span>✦</span><p>“The petrol and toll were from today’s Gurgaon trip. Blinkit was groceries.”</p></div>
      <label class="batch-field listening-field"><span>What happened?</span><textarea id="batch-input" rows="5" placeholder="Speak or type one sentence about today’s spending…"></textarea><i class="field-loader" aria-label="Listening" hidden></i></label>
      <div class="batch-list" id="batch-list" aria-label="Payments available to match">
        {transactions.map((item) => <span data-batch-id={item.id}><i class={`mini-dot ${item.tone}`}></i>{item.merchant} · {item.amount}</span>)}
      </div>
      <div class="sheet-actions"><button class="secondary-button" type="button" id="batch-voice" data-voice-label>● Speak instead</button><button class="primary-button" type="button" id="batch-submit">Match & explain <span>→</span></button></div>
      <div class="batch-result" id="batch-result" hidden><span>✓</span><p><strong>Explanation applied</strong><small id="batch-result-text"></small></p></div>
    </dialog>

    <dialog class="sheet-dialog preferences-dialog" id="preferences-dialog">
      <div class="sheet-top"><div><span class="eyebrow">REMINDER PREFERENCES</span><h2>Make reminders feel right.</h2></div><button type="button" data-close-preferences aria-label="Close preferences">×</button></div>
      <p class="sheet-intro">Paisa sends at most one useful reminder a day, and stays quiet when everything is already understood.</p>
      <form id="preferences-form">
        <fieldset class="personality-options"><legend>Reminder personality</legend>
          <label><input type="radio" name="personality" value="Gentle" /><span><strong>Gentle</strong><small>Only when unresolved spending exceeds ₹2,000.</small></span></label>
          <label><input type="radio" name="personality" value="Balanced" checked /><span><strong>Balanced <em>Recommended</em></strong><small>Two payments or one important payment remains.</small></span></label>
          <label><input type="radio" name="personality" value="Strict" /><span><strong>Strict</strong><small>Daily whenever anything meaningful remains.</small></span></label>
        </fieldset>
        <div class="preference-grid">
          <label><span>Preferred review time</span><input name="reviewTime" type="time" value="21:30" /></label>
          <label><span>Important payment</span><select name="importantAmount"><option value="1000">Above ₹1,000</option><option value="2000">Above ₹2,000</option><option value="5000">Above ₹5,000</option></select></label>
          <label><span>Quiet hours start</span><input name="quietStart" type="time" value="23:00" /></label>
          <label><span>Quiet hours end</span><input name="quietEnd" type="time" value="07:00" /></label>
        </div>
        <label class="toggle-row"><span><strong>Sunday cleanup</strong><small>Show a weekly catch-up only when missing context affects your insights.</small></span><input name="weeklyCleanup" type="checkbox" checked /><i></i></label>
        <div class="preference-note"><span>♢</span><p><strong>Anti-annoyance rules are always on.</strong><small>No repeated evening alerts, known EMIs, reversals, refunds, or reminders after you’ve already reviewed.</small></p></div>
        <div class="data-controls"><div><strong>Your data</strong><small>Download a portable copy or permanently delete your Paisa records.</small></div><span><button type="button" id="export-data">Export</button><button type="button" id="delete-account">Delete account</button></span></div>
        <div class="sheet-actions"><button class="secondary-button" type="button" data-close-preferences>Cancel</button><button class="primary-button" type="submit">Save preferences</button></div>
      </form>
    </dialog>

    <dialog class="completion-dialog" id="completion-dialog">
      <div class="completion-mark">✓</div><span class="eyebrow">REVIEW COMPLETE</span><h2>Done. Your money makes sense.</h2>
      <p>Today was higher than usual mainly because of the Gurgaon trip. Your normal day-to-day spending was unchanged.</p>
      <div class="completion-stats"><span><strong id="completed-count">5</strong><small>PAYMENTS REVIEWED</small></span><span><strong>~90 sec</strong><small>TIME SPENT</small></span><span><strong>12 days</strong><small>CLARITY STREAK</small></span></div>
      <button class="primary-button" type="button" data-close-completion>Back to overview</button>
    </dialog>

    <dialog class="sheet-dialog import-dialog" id="import-dialog">
      <div class="sheet-top"><div><span class="eyebrow">IMPORT TRANSACTIONS</span><h2>Bring your spending into Paisa.</h2></div><button type="button" data-close-import aria-label="Close import">×</button></div>
      <p class="sheet-intro">Upload your bank statement as a PDF or CSV. PDF text is read in your browser; Paisa sends only the transactions you confirm.</p>
      <label class="file-drop" id="file-drop"><input id="statement-file" type="file" accept=".csv,.pdf,text/csv,application/pdf" /><span>⇧</span><strong>Choose a bank PDF or CSV</strong><small>PDF statements up to 20 MB · password-protected files supported</small></label>
      <div class="import-loading" id="import-loading" hidden><i></i><span><strong>Reading statement…</strong><small>This can take a few seconds for large PDFs.</small></span></div>
      <div class="import-preview" id="import-preview" hidden><div><strong id="import-count">0 transactions ready</strong><small id="import-filename"></small></div><button type="button" id="clear-import">Remove</button></div>
      <div class="preference-note"><span>♢</span><p><strong>Your raw statement is never uploaded or stored.</strong><small>Extraction happens locally. Only the parsed transaction rows are sent after you confirm.</small></p></div>
      <div class="sheet-actions"><button class="secondary-button" type="button" data-close-import>Cancel</button><button class="primary-button" type="button" id="import-submit" disabled>Import securely</button></div>
    </dialog>

    <div class="toast" role="status" aria-live="polite"><span>✓</span><p><strong>Context saved</strong><small>Moving to the next payment</small></p></div>

    <script is:inline src="/client.js"></script>
  </body>
</html>

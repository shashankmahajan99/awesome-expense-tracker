---
interface Props { title: string; subtitle?: string; action?: "add" | "review" | "none"; }
const { title, subtitle = "YOUR MONEY, CLEARLY", action = "none" } = Astro.props;
---
<header class="topbar">
  <button class="menu-button" type="button" aria-label="Open menu" data-menu>☰</button>
  <div><p class="date">{subtitle}</p><h1>{title}</h1></div>
  <div class="top-actions">
    <a class="import-button" href="/?import=1">＋ Import</a>
    {action === "add" && <button class="primary-button" type="button" data-add-transaction><span>＋</span> Add transaction</button>}
    {action === "review" && <button class="primary-button loading-control" type="button" data-open-review disabled><span>✦</span> Review today</button>}
    {action === "none" && <a class="primary-button" href="/"><span>←</span> Dashboard</a>}
  </div>
</header>
